{
  "name": "marvelverse-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.5.0",
  "engines": {
    "node": "\u003e=20.0.0",
    "pnpm": "\u003e=9.0.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "build": "pnpm -r run build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "data:tmdb:test": "pnpm --filter marvelverse-backend exec tsx src/scripts/tmdb-test-acquisition.ts",
    "data:canonical:verify": "pnpm --filter marvelverse-backend exec tsx src/scripts/canonical-verify.ts",
    "data:repository:verify": "pnpm --filter marvelverse-backend exec tsx src/scripts/repository-verify.ts",
    "data:api:verify": "pnpm --filter marvelverse-backend exec tsx src/scripts/api-verify.ts",
    "clean": "pnpm -r run clean",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.3.0",
    "@commitlint/config-conventional": "^19.2.2",
    "eslint": "^9.6.0",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.7",
    "prettier": "^3.3.2",
    "typescript": "^5.5.3"
  },
  "workspaces": [
    "frontend",
    "backend",
    "shared"
  ],
  "type": "module"
}
